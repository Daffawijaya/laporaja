# Salin file ini menjadi .env.local lalu isi nilainya.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key-di-sini
# Hanya dipakai server dan script seed. Jangan pakai di browser.
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-di-sini
# Google Drive (SERVER ONLY, tanpa prefix NEXT_PUBLIC_). Folder root Laporaja.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
